        function updateStats() {
            const uniquePeople = new Set(shifts.map(s => s.name));
            const uniqueDays = new Set(shifts.map(s => s.date));
            const unassigned = shifts.filter(s => !s.location || s.location === '未定').length;

            document.getElementById('statPeople').textContent = `${uniquePeople.size}名`;
            document.getElementById('statDays').textContent = `${uniqueDays.size}日`;
            document.getElementById('statUnassigned').textContent = `${unassigned}件`;
