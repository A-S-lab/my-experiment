                    const badge = getTimeBadgeStyle(s.location);
                    html += `
                        <div onclick="openEditModal('${s.id}')" class="py-2 px-2 flex items-center justify-between hover:bg-slate-50 rounded-lg cursor-pointer transition">
                            <span class="text-xs font-bold text-slate-600">${escapeHTML(formatDisplayDate(s.date))}</span>
                            <span class="px-2.5 py-1 rounded-lg border text-xs font-bold ${badge}">${escapeHTML(s.location)}</span>
                        </div>
                    `;
                });

                html += `</div></div>`;
            });

            html += `</div>`;
            container.innerHTML = html;
        }

        // ==========================================
        // 編集モーダル・削除処理
        // ==========================================
        function openEditModal(shiftId) {
            const shift = shifts.find(s => s.id === shiftId);
            if (!shift) return;

            editingShiftId = shiftId;
            document.getElementById('modalInfo').innerHTML = `
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900">${escapeHTML(shift.name)} さん</span>
                    <span class="text-xs font-bold bg-indigo-100 text-indigo-800 px-2.5 py-1 rounded-lg">${escapeHTML(formatDisplayDate(shift.date))}</span>
                </div>
            `;

            const presets = ['9:00-14:00', '10:00-15:00', '13:00-18:00', '17:00-22:00', '18:00-23:00', '終日OK', '早番', '遅番', '未定'];
            const existingLocs = [...new Set(shifts.map(s => s.location).filter(Boolean))];
            const allButtons = [...new Set([...presets, ...existingLocs])].slice(0, 12);

            const btnContainer = document.getElementById('quickLocationButtons');
            btnContainer.innerHTML = allButtons.map(loc => `
                <button type="button" onclick="document.getElementById('modalLocationInput').value='${escapeHTML(loc).replace(/'/g, "\\'")}'"
                    class="text-xs bg-slate-100 hover:bg-indigo-100 hover:text-indigo-700 text-slate-700 font-medium px-2.5 py-1.5 rounded-lg transition">
                    ${escapeHTML(loc)}
                </button>
            `).join('');

            document.getElementById('modalLocationInput').value = shift.location || '';

            const modal = document.getElementById('editModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            editingShiftId = null;
            const modal = document.getElementById('editModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveModalLocation() {
            if (!editingShiftId) return;
            const shift = shifts.find(s => s.id === editingShiftId);
            if (!shift) return;

            const rawVal = document.getElementById('modalLocationInput').value.trim();
            if (rawVal) {
                const { time } = extractTimeStr(normalizeText(rawVal));
                shift.location = time || rawVal;
            } else {
                shift.location = '未定';
            }

            saveToStorage();
            renderAll();
            closeModal();
            showToast('シフト時間を更新しました');
        }

        function deleteCurrentShift() {
            if (!editingShiftId) return;
            shifts = shifts.filter(s => s.id !== editingShiftId);
            saveToStorage();
            renderAll();
            closeModal();
            showToast('シフトを削除しました');
        }

        // 全削除確認モーダル
        function confirmClearAll() {
            if (shifts.length === 0) {
                showToast('削除するデータがありません', true);
                return;
            }
            const modal = document.getElementById('confirmModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfirmModal() {
            const modal = document.getElementById('confirmModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function executeClearAll() {
            shifts = [];
            saveToStorage();
            renderAll();
            closeConfirmModal();
            showToast('すべてのシフトデータを削除しました');
        }
    </script>
</body>
</html>
