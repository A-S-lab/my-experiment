        // 時間文字列から開始・終了時間（数値）を解析（例: 9:30-14:00 -> {start: 9.5, end: 14.0}）
        function parseTimeRangeHours(loc) {
            if (!loc || loc === '未定') return null;
            if (loc.includes('終日')) return { start: 8, end: 23, label: loc, color: 'bg-emerald-500' };
            if (loc.includes('早番')) return { start: 8, end: 15, label: loc, color: 'bg-sky-500' };
            if (loc.includes('遅番')) return { start: 16, end: 23, label: loc, color: 'bg-purple-500' };
            if (loc.includes('午前') || loc.includes('ランチ')) return { start: 9, end: 14, label: loc, color: 'bg-sky-500' };
            if (loc.includes('午後')) return { start: 13, end: 18, label: loc, color: 'bg-indigo-500' };
            if (loc.includes('ディナー') || loc.includes('夜')) return { start: 17, end: 23, label: loc, color: 'bg-purple-500' };

            const rangeMatch = loc.match(/(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})/);
            if (rangeMatch) {
                const s = parseInt(rangeMatch[1], 10) + parseInt(rangeMatch[2], 10) / 60;
                const e = parseInt(rangeMatch[3], 10) + parseInt(rangeMatch[4], 10) / 60;
                return { start: s, end: Math.max(s + 0.5, e), label: loc, color: 'bg-indigo-500' };
            }

            const openMatch = loc.match(/(\d{1,2}):(\d{2})〜/);
            if (openMatch) {
                const s = parseInt(openMatch[1], 10) + parseInt(openMatch[2], 10) / 60;
                return { start: s, end: 23, label: loc, color: 'bg-indigo-500' };
            }

            const closeMatch = loc.match(/〜(\d{1,2}):(\d{2})/);
            if (closeMatch) {
                const e = parseInt(closeMatch[1], 10) + parseInt(closeMatch[2], 10) / 60;
                return { start: 8, end: e, label: loc, color: 'bg-indigo-500' };
            }

            return null;
        }

        // 1. タイムバー表（1時間刻みガントチャート）
        function renderTimelineView(container, data) {
            const dates = [...new Set(data.map(s => s.date))].sort();
            const startHour = 8;
            const endHour = 23;
            const totalHours = endHour - startHour; // 15時間分 (8:00〜23:00)

            let hourHeaders = '';
            for (let h = startHour; h < endHour; h++) {
                hourHeaders += `<div class="flex-1 text-center text-[10px] font-semibold text-slate-400 border-l border-slate-200 py-1">${h}</div>`;
            }

            let html = `<div class="space-y-6 fade-in">`;

            dates.forEach(date => {
                const dayShifts = data.filter(s => s.date === date).sort((a, b) => a.name.localeCompare(b.name));
                const dispDate = formatDisplayDate(date);
                const isSun = dispDate.includes('(日)');
                const isSat = dispDate.includes('(土)');
                const badgeColor = isSun ? 'bg-rose-100 text-rose-700' : isSat ? 'bg-sky-100 text-sky-700' : 'bg-slate-100 text-slate-700';

                // 時間帯ごとの人数カウント（8時〜22時）
                const hourlyCounts = Array(totalHours).fill(0);
                dayShifts.forEach(s => {
                    const parsed = parseTimeRangeHours(s.location);
                    if (parsed) {
                        for (let h = startHour; h < endHour; h++) {
                            if (parsed.start < h + 1 && parsed.end > h) {
                                hourlyCounts[h - startHour]++;
                            }
                        }
                    }
                });

                html += `
                    <div class="border border-slate-200 rounded-xl overflow-hidden bg-white shadow-2xs">
                        <div class="bg-slate-50 px-4 py-2.5 border-b border-slate-200 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-lg text-xs font-bold ${badgeColor}">${escapeHTML(dispDate)}</span>
                                <span class="text-xs text-slate-500 font-medium">稼働予定: <strong class="text-slate-800">${dayShifts.length}名</strong></span>
                            </div>
                            <span class="text-[11px] text-slate-400">バーをクリックで時間編集</span>
                        </div>
                        <div class="overflow-x-auto">
                            <div class="min-w-[640px]">
                                <!-- 時間軸ヘッダー -->
                                <div class="flex border-b border-slate-200 bg-slate-50/50">
                                    <div class="w-28 shrink-0 px-3 py-1 text-[11px] font-bold text-slate-500 flex items-center">スタッフ</div>
                                    <div class="flex-grow flex">${hourHeaders}</div>
                                </div>
                `;

                dayShifts.forEach(s => {
                    const parsed = parseTimeRangeHours(s.location);
                    let barHtml = '';

                    if (parsed) {
                        const clampedStart = Math.max(startHour, Math.min(endHour, parsed.start));
                        const clampedEnd = Math.max(clampedStart + 0.5, Math.min(endHour, parsed.end));
                        const leftPct = ((clampedStart - startHour) / totalHours) * 100;
                        const widthPct = ((clampedEnd - clampedStart) / totalHours) * 100;

                        barHtml = `
                            <button onclick="openEditModal('${s.id}')" style="left: ${leftPct}%; width: ${widthPct}%;"
                                class="absolute top-1.5 bottom-1.5 ${parsed.color} hover:opacity-90 text-white rounded-md shadow-xs px-2 flex items-center justify-center text-[11px] font-bold truncate transition cursor-pointer"
                                title="${escapeHTML(s.name)}: ${escapeHTML(s.location)}">
                                ${escapeHTML(s.location)}
                            </button>
                        `;
                    } else {
                        barHtml = `
                            <button onclick="openEditModal('${s.id}')"
                                class="absolute inset-y-1.5 left-2 px-3 bg-amber-100 hover:bg-amber-200 text-amber-800 border border-amber-300 rounded-md text-[11px] font-bold flex items-center gap-1 transition cursor-pointer">
                                <i class="fa-regular fa-clock"></i> ${escapeHTML(s.location || '未定')}（クリックして設定）
                            </button>
                        `;
                    }

                    // 背景グリッド線
                    let gridBg = '';
                    for (let h = startHour; h < endHour; h++) {
                        gridBg += `<div class="flex-1 border-l border-slate-100 h-full"></div>`;
                    }

                    html += `
                        <div class="flex border-b border-slate-100 last:border-b-0 hover:bg-slate-50/80 transition h-10">
                            <div class="w-28 shrink-0 px-3 flex items-center justify-between border-r border-slate-100">
                                <span class="text-xs font-bold text-slate-700 truncate">${escapeHTML(s.name)}</span>
                            </div>
                            <div class="flex-grow relative flex">
                                ${gridBg}
                                ${barHtml}
                            </div>
                        </div>
                    `;
                });

                // 時間別合計人数フッター
                let countCells = '';
                hourlyCounts.forEach(cnt => {
                    const cellStyle = cnt === 0
                        ? 'text-slate-300 bg-slate-50/30'
                        : cnt >= 3
                            ? 'text-emerald-700 bg-emerald-50/70 font-bold'
                            : 'text-indigo-700 bg-indigo-50/40 font-semibold';
                    countCells += `<div class="flex-1 text-center text-[10px] border-l border-slate-200 py-1 ${cellStyle}">${cnt}人</div>`;
                });

                html += `
                                <div class="flex border-t border-slate-200 bg-slate-50">
                                    <div class="w-28 shrink-0 px-3 py-1 text-[10px] font-bold text-slate-500 flex items-center">時間別人数</div>
                                    <div class="flex-grow flex">${countCells}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            html += `</div>`;
            container.innerHTML = html;
        }

