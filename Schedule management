                        </div>
                        <p class="font-bold text-slate-600 mb-1">表示するシフトデータがありません</p>
                        <p class="text-xs">左のフォームからシフトを貼り付けるか、「サンプル読込」をお試しください。</p>
                    </div>
                `;
                return;
            }

            if (currentTab === 'timeline') {
                renderTimelineView(container, filtered);
            } else if (currentTab === 'matrix') {
