        // ==========================================
        // モーダル操作・データ削除
        // ==========================================
        function openEditModal(shiftId) {
            const target = shifts.find(s => s.id === shiftId);
            if (!target) return;

            editingShiftId = shiftId;
            document.getElementById('modalInfo').innerHTML = `
                <span class="font-bold">${escapeHTML(target.name)}</span> さん —
                <span class="font-semibold text-indigo-700">${escapeHTML(formatDisplayDate(target.date))}</span>
            `;
            document.getElementById('modalLocationInput').value = target.location || '';

            const presets = ['9:00-14:00', '10:00-15:00', '13:00-18:00', '17:00-22:00', '18:00-23:00', '終日OK', '未定'];
            const quickContainer = document.getElementById('quickLocationButtons');
            quickContainer.innerHTML = presets.map(p => `
                <button type="button" onclick="document.getElementById('modalLocationInput').value='${p}'" class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-indigo-100 hover:text-indigo-700 text-slate-700 font-medium transition">
                    ${p}
                </button>
            `).join('');

            const modal = document.getElementById('editModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            editingShiftId = null;
            const modal = document.getElementById('editModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveModalLocation() {
            if (!editingShiftId) return;
            const idx = shifts.findIndex(s => s.id === editingShiftId);
            if (idx >= 0) {
                const rawVal = document.getElementById('modalLocationInput').value.trim();
                if (!rawVal) {
                    shifts[idx].location = '未定';
                } else {
                    const { time } = extractTimeStr(normalizeText(rawVal));
                    shifts[idx].location = time || rawVal;
                }
                saveToStorage();
                renderAll();
                showToast('入り可能時間を更新しました');
            }
            closeModal();
        }

        function deleteCurrentShift() {
            if (!editingShiftId) return;
            shifts = shifts.filter(s => s.id !== editingShiftId);
            saveToStorage();
            renderAll();
            showToast('シフトを削除しました');
            closeModal();
        }

        function confirmClearAll() {
            const modal = document.getElementById('confirmModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfirmModal() {
            const modal = document.getElementById('confirmModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function executeClearAll() {
            shifts = [];
            saveToStorage();
            renderAll();
            closeConfirmModal();
            showToast('すべてのデータを削除しました');
        }
    </script>
</body>
</html>
