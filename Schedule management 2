        // 時間文字列（例: "9:00-14:00", "17:00〜", "終日OK"）を数値の範囲 [startHour, endHour] に変換
        function parseTimeRangeToHours(loc, minH, maxH) {
            if (!loc || loc === '未定') return null;
            if (loc.includes('終日')) return [minH, maxH];
            if (loc.includes('早番')) return [9, 15];
            if (loc.includes('遅番')) return [17, 23];
            if (loc.includes('午前')) return [9, 12];
            if (loc.includes('午後')) return [13, 18];
            if (loc.includes('ランチ')) return [10, 15];
            if (loc.includes('ディナー') || loc.includes('夜')) return [17, 22];

            const rangeMatch = loc.match(/(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})/);
            if (rangeMatch) {
                const start = parseInt(rangeMatch[1], 10) + parseInt(rangeMatch[2], 10) / 60;
                const end = parseInt(rangeMatch[3], 10) + parseInt(rangeMatch[4], 10) / 60;
                return [start, Math.max(start + 1, end)];
            }

            const openMatch = loc.match(/(\d{1,2}):(\d{2})\s*〜/);
            if (openMatch) {
                const start = parseInt(openMatch[1], 10) + parseInt(openMatch[2], 10) / 60;
                return [start, maxH];
            }

            const closeMatch = loc.match(/〜\s*(\d{1,2}):(\d{2})/);
            if (closeMatch) {
                const end = parseInt(closeMatch[1], 10) + parseInt(closeMatch[2], 10) / 60;
                return [minH, end];
            }

            return null;
        }

        // 1. タイムバー表（1時間刻みで見やすく整理）
        function renderTimelineView(container, data) {
            const dates = [...new Set(data.map(s => s.date))].sort();
            const names = [...new Set(data.map(s => s.name))];
            const minH = 8;
            const maxH = 23;
            const hours = [];
            for (let h = minH; h < maxH; h++) hours.push(h);

            let html = `
                <div class="overflow-x-auto border border-slate-200 rounded-xl max-h-[640px] relative">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead class="bg-slate-100 sticky top-0 z-20 shadow-xs">
                            <tr>
                                <th class="p-3 border-b border-r border-slate-200 font-bold text-slate-700 sticky left-0 bg-slate-100 z-30 min-w-[100px]">日付・曜日</th>
                                <th class="p-3 border-b border-r border-slate-200 font-bold text-slate-700 sticky left-[100px] bg-slate-100 z-30 min-w-[105px]">時間帯</th>
                                ${names.map(name => `<th class="p-3 border-b border-r border-slate-200 font-bold text-slate-800 text-center min-w-[125px]">${escapeHTML(name)}</th>`).join('')}
                            </tr>
                        </thead>
                        <tbody>
            `;

            dates.forEach((date, dIdx) => {
                const dispDate = formatDisplayDate(date);
                const isSun = dispDate.includes('(日)');
                const isSat = dispDate.includes('(土)');
                const dateBg = isSun ? 'bg-rose-50/70 text-rose-700' : (isSat ? 'bg-sky-50/70 text-sky-700' : 'bg-white text-slate-800');
                const borderTopClass = dIdx > 0 ? 'border-t-2 border-t-slate-300' : '';

                hours.forEach((h, hIdx) => {
                    const rowBorderClass = hIdx === 0 ? borderTopClass : 'border-t border-t-slate-200';

                    html += `<tr class="hover:bg-slate-50/80 ${rowBorderClass}">`;
                    if (hIdx === 0) {
                        html += `
                            <td rowspan="${hours.length}" class="p-3 border-b border-r border-slate-200 font-bold align-top sticky left-0 z-10 ${dateBg}">
                                <div class="sticky top-14">${escapeHTML(dispDate)}</div>
                            </td>
                        `;
                    }
                    html += `
                        <td class="px-2.5 py-2 border-r border-slate-200 font-mono text-[11px] font-semibold text-slate-600 whitespace-nowrap sticky left-[100px] bg-slate-50/90 z-10">
                            ${h}:00 - ${h + 1}:00
                        </td>
                    `;

                    names.forEach(name => {
                        const shift = data.find(s => s.date === date && s.name === name);
                        const range = shift ? parseTimeRangeToHours(shift.location, minH, maxH) : null;

                        const isActive = range && (h + 1 > range[0] && h < range[1]);
                        const isStart = range && (range[0] >= h && range[0] < h + 1);
                        const isEnd = range && (range[1] <= h + 1);

                        if (shift && isActive) {
                            const barColor = shift.location.includes('終日') ? 'bg-emerald-500' : 'bg-indigo-500';
                            html += `
                                <td onclick="openEditModal('${shift.id}')" class="p-0 border-r border-slate-200 cursor-pointer relative group h-8" title="${escapeHTML(name)}: ${escapeHTML(shift.location)}">
                                    <div class="mx-2 h-full ${barColor} group-hover:opacity-85 transition flex items-center justify-center text-white font-bold text-[11px] px-1 truncate ${isStart ? 'rounded-t-md' : ''} ${isEnd ? 'rounded-b-md' : ''}">
                                        ${isStart ? escapeHTML(shift.location) : ''}
                                    </div>
                                </td>
                            `;
                        } else if (shift && hIdx === 0 && !range) {
                            html += `
                                <td onclick="openEditModal('${shift.id}')" class="p-1 border-r border-slate-200 cursor-pointer text-center h-8">
                                    <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-amber-100 text-amber-800">${escapeHTML(shift.location)}</span>
                                </td>
                            `;
                        } else {
                            html += `
                                <td onclick="quickAdd('${escapeHTML(name)}', '${date}')" class="p-0 border-r border-slate-100 cursor-pointer hover:bg-indigo-50/40 transition h-8"></td>
                            `;
                        }
                    });

                    html += `</tr>`;
                });
            });

            html += `</tbody></table></div>`;
            container.innerHTML = html;
        }

        // 2. シフトマトリクス表ビュー
